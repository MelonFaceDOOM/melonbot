# Copy to .env and fill in. .env is gitignored.

# === Controls (flip these) ===
# MELONBOT_DB:  dev | prod  → picks DB name + bot token + command prefix
#               (defaults: dev → ?, prod → !; override with DEV_COMMAND_PREFIX / PROD_COMMAND_PREFIX)
# USE_SSH_TUNNEL: 0 = bot on DB server (direct loopback); 1 = SSH from elsewhere
MELONBOT_DB=dev
USE_SSH_TUNNEL=1

# === How to reach Postgres ===
# REMOTE_* = Postgres ON THE SERVER (almost always loopback). Never a LAN IP for direct DB.
# SSH_* used only when USE_SSH_TUNNEL=1 (SSH_HOST may be the server's LAN IP).
REMOTE_DB_HOST=127.0.0.1
REMOTE_DB_PORT=5432
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PKEY=
# SSH_PKEY_PASSWORD=
# SSH_PASSWORD=

# === Credentials for MELONBOT_DB=prod ===
PROD_BOT_TOKEN=
PROD_DB_NAME=melonbot
PROD_DB_USER=postgres
PROD_DB_PASSWORD=

# === Credentials for MELONBOT_DB=dev ===
DEV_BOT_TOKEN=
DEV_DB_NAME=melonbot_dev
DEV_DB_USER=postgres
DEV_DB_PASSWORD=

# === Other services ===
GOOGLE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_NARRATE_KEY=

SFTP_HOST=
SFTP_PORT=22
SFTP_USER=
SFTP_PASSWORD=
SFTP_BASE_DIR=streams

LOCAL_STREAM_FILE_LOCATION=/mnt/md0/nitwitch_dl/streams
WEB_STREAM_FILE_LOCATION=https://nitwitch.com/dl/streams

TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
TWITCH_REFRESH_TOKEN=

# STREAMLINK_BIN=D:/code/melonbot/venv/Scripts/streamlink.exe
